{
  "manifest_version": 3,
  "name": "Mauvely OS sign-in",
  "version": "0.1.0",
  "description": "Signs this browser in to Mauvely with the account this computer is linked to.",
  "browser_specific_settings": {
    "gecko": {
      "id": "os-signin@mauvely.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["nativeMessaging", "cookies"],
  "host_permissions": ["https://*.mauvely.com/*", "https://*.mauvely.dev/*"],
  "background": { "scripts": ["signin.js", "background.js"] }
}

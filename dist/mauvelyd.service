[Unit]
Description=Mauvely device agent
Documentation=https://github.com/Mauvely/os-agent
# tuned sets kernel arguments through `bootc loader-entries` while it starts,
# which waits for the sysroot lock. An image switch started first holds it for
# over a minute, tuned's start times out, and power profiles are gone for that
# boot (seen on the first Proxmox install). Started after it, the agent waits.
After=network-online.target tuned.service
Wants=network-online.target
# Unprovisioned machines (no installer run) have nothing to talk to.
ConditionPathExists=/etc/mauvely/server

[Service]
Type=exec
ExecStart=/usr/bin/mauvelyd run
Restart=on-failure
RestartSec=30s
StateDirectory=mauvely
StateDirectoryMode=0700
# /run/mauvely/installed.json, which mauvely-session reads as the person to say
# an app is ready. Everyone reads it; it stays through a restart of the agent
# and goes at the next boot.
RuntimeDirectory=mauvely
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# Hardening that still lets flatpak, bootc and systemd-creds run as root.
# A user's --user installs live under /home and stay out of reach.
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Left out on purpose:
# - ProtectSystem: bootc switch writes /sysroot and /boot, flatpak writes
#   /var/lib/flatpak, and systemd-creds may create
#   /var/lib/systemd/credential.secret.
# - NoNewPrivileges: it blocks the SELinux domain transitions bootc and
#   ostree run under on Fedora.
# - RestrictSUIDSGID: a staged OS image carries setuid binaries (sudo,
#   passwd), and ostree has to create them.
# - PrivateDevices, DevicePolicy, ProtectClock: each restricts /dev, and
#   systemd-creds needs /dev/tpmrm0.
# - RestrictNamespaces: flatpak runs its triggers in bubblewrap, and ostree
#   mounts in a namespace of its own.
# - CapabilityBoundingSet: bootc needs most of root.
# - UMask=0077: flatpak's repo config and the deployments bootc stages must
#   stay readable by users. The agent's own files are written 0600 anyway.

[Install]
WantedBy=multi-user.target
